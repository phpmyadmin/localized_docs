msgstr "Ajánlott a ``'mysqli'`` használata az összes telepítésnél."

#: ../phpmyadmin/docs/config.rst:778
msgid ""
"The name of the database containing the phpMyAdmin configuration storage."
msgstr "A phpMyAdmin beállítástárolóját tartalmazó adatbázis neve."

# b2d98778b4ec4f0e98263704f39b8bd5
