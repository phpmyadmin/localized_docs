# 6d9c2c722dce45a39b9912062ea88ec9
#: ../phpmyadmin/docs/config.rst:3188
msgid ""
"Maximum number of characters shown in any non-numeric field on browse view. "
"Can be turned off by a toggle button on the browse page."
msgstr ""
"A böngészési nézetben bármely nem numerikus mezőben megjelenített karakterek "
"maximális száma. A böngészési oldalon egy kapcsológombbal kikapcsolható."

# 8b2e7fe452e3401991f009d754c80e5f
#: ../phpmyadmin/docs/config.rst:3194
msgid "``'left'``"
